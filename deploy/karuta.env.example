APP_ENV=production
BIND_ADDR=127.0.0.1
PORT=8080
JWT_SECRET=replace-with-at-least-32-random-characters
DB_PATH=/data/karuta/karuta.db
CORS_ALLOWED_ORIGINS=https://karuta.example.com

# Optional Bangumi API token
BANGUMI_TOKEN=

# Registration mode used by the current application
INVITE_REQUIRED=true

# Tencent COS media storage (required: the only media backend;
# server-local storage has been removed)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_CDN_DOMAIN=

# One-time compatibility maintenance only. Keep disabled during normal starts.
COS_FIX_CACHE_ON_START=false

# B2 media quotas (0 = unlimited). Quota breaches return HTTP 413 QUOTA_EXCEEDED.
QUOTA_USER_BYTES=0
QUOTA_DAILY_UPLOADS=0
