# 统一换行符：文本文件在仓库内恒为 LF。
# 必要性：一键部署脚本在本机（Windows）打包/上传到 Linux 服务器执行，
# 若按 CRLF 检出，服务器上会报 `bash: /usr/bin/env: 'bash\r'` 之类的错。
# 二进制类型显式声明，避免 Git 去"猜"。
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.go    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.service text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.exe   binary
*.db    binary
